+    sentences = ["Hello world.", "Second line."]
+    words = [
+        WordTiming("Hello", 0, 200),
+        WordTiming("world.", 200, 500),
+        WordTiming("Second", 500, 800),
+        WordTiming("line.", 800, 1000),
+    ]
+    durs = sentence_durations_s(sentences, words)
+    assert len(durs) == 2
+    assert abs(durs[0] - 0.5) < 1e-6
