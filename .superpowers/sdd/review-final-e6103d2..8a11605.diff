 _EPSILON = 1e-6
 
 
 @dataclass(frozen=True)
 class ClipSegment:
     path: Path
     start_s: float  # always 0 for v1
     duration_s: float
 
@@ -53,10 +55,65 @@ def plan_reddit_clips(
         path = bag.pop()
         duration = _duration_for(path, durations)
         if duration <= 0:
             raise ValueError(f"duration must be positive for {path}")
 
         use = min(duration, remaining)
